
/* ===== v2.0 C 稿通用 ===== */
page { background: #F4F7F3; }
.page { padding: 8rpx 32rpx 48rpx; color: #14211A; font-variant-numeric: tabular-nums; }
.up { color: #D9363E; } .down { color: #1E9B5A; } .flat { color: #8A978F; }
.up-green { color: #1E9B5A; } .down-green { color: #D9363E; }
.pill { font-size: 24rpx; font-weight: 700; padding: 6rpx 12rpx; border-radius: 14rpx; min-width: 112rpx; text-align: center; box-sizing: border-box; }
.pill.up, .pill.down-green { background: #FDECEC; } .pill.down, .pill.up-green { background: #E6F5EC; } .pill.flat { background: #F0F3F0; }
.card { background: #FFFFFF; border: 1rpx solid #E6ECE7; border-radius: 40rpx; padding: 24rpx 32rpx 8rpx; margin: 24rpx 0 0; box-shadow: none; overflow: visible; }
.empty { padding: 40rpx 0; text-align: center; color: #9AA69F; font-size: 26rpx; }
.notice { display: flex; align-items: center; gap: 12rpx; margin-top: 20rpx; padding: 18rpx 24rpx; border-radius: 24rpx; font-size: 24rpx; }
.notice.calm { background: #EAF0EB; color: #5E6E64; }
.notice.calm .dot { color: #B7C2BB; }
.notice.warn { background: #FFF1E6; color: #8F4E10; }
.notice.fest { background: #FFF7E0; color: #7A5A00; }
.notice-k { font-weight: 700; flex-shrink: 0; }
.notice-v { flex: 1; min-width: 0; }
.notice-a { flex-shrink: 0; opacity: .7; }
.foot { margin-top: 32rpx; text-align: center; font-size: 21rpx; color: #8A978F; line-height: 1.6; }
.skeleton { margin-top: 24rpx; }
.sk-card { height: 140rpx; border-radius: 40rpx; background: linear-gradient(90deg, #E9EDEA 25%, #F2F5F2 50%, #E9EDEA 75%); background-size: 200% 100%; animation: sk 1.2s infinite; margin-bottom: 24rpx; }
.sk-card.tall { height: 360rpx; }
@keyframes sk { 0% { background-position: 100% 0; } 100% { background-position: -100% 0; } }
.error-box { margin-top: 48rpx; text-align: center; }
.err-text { color: #5E6E64; font-size: 28rpx; margin-bottom: 24rpx; }
.btn-retry { display: inline-block; padding: 16rpx 48rpx; border-radius: 40rpx; background: #14532D; color: #fff; font-size: 28rpx; }

.refresh-bar { text-align: center; font-size: 24rpx; color: #5E6E64; padding: 12rpx 0; }
.hd { display: flex; justify-content: space-between; align-items: center; padding: 8rpx 0 0; }
.hd-sub { font-size: 24rpx; color: #5E6E64; }
.loc { font-size: 24rpx; color: #3E4C44; background: #fff; border: 1rpx solid #E1E8E2; border-radius: 40rpx; padding: 8rpx 20rpx; }
/* 搜索 */
.search { margin-top: 20rpx; display: flex; align-items: center; background: #fff; border: 1rpx solid #E1E8E2; border-radius: 28rpx; padding: 0 24rpx; height: 84rpx; }
.search-ico { font-size: 34rpx; color: #8A978F; margin-right: 12rpx; }
.search-input { flex: 1; font-size: 28rpx; height: 84rpx; }
.search-ph { color: #9AA69F; }
.search-clear { font-size: 26rpx; color: #8A978F; padding: 12rpx; }
.search-history { display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; margin-top: 12rpx; }
.sh-label { font-size: 22rpx; color: #8A978F; }
.sh-item { font-size: 24rpx; background: #E6ECE7; color: #3E4C44; border-radius: 20rpx; padding: 6rpx 18rpx; }
/* 天气三格 */
.wx { display: flex; gap: 12rpx; margin-top: 24rpx; }
.wd { flex: 1; background: #fff; border: 1rpx solid #E6ECE7; border-radius: 24rpx; padding: 16rpx 20rpx; display: flex; flex-direction: column; min-width: 0; }
.wd.now { border-color: #CFE3D6; }
.wd-l { font-size: 21rpx; color: #8A978F; }
.wd-t { font-size: 25rpx; font-weight: 600; margin: 4rpx 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.wd-c { font-size: 24rpx; color: #3E4C44; }
.wsrc { text-align: right; font-size: 20rpx; color: #9AA69F; margin-top: 6rpx; }
/* 品类切换 */
.seg { margin-top: 24rpx; background: #E6ECE7; border-radius: 28rpx; padding: 8rpx; display: flex; }
.seg-i { flex: 1; text-align: center; padding: 14rpx 0; border-radius: 22rpx; display: flex; flex-direction: column; color: #5E6E64; }
.seg-i.on { background: #fff; color: #14211A; box-shadow: 0 2rpx 6rpx rgba(0,0,0,.08); }
.seg-t { font-size: 30rpx; font-weight: 600; }
.seg-s { font-size: 21rpx; margin-top: 2rpx; }
/* 头条卡 */
.hero { margin-top: 24rpx; background: #14532D; border-radius: 40rpx; padding: 32rpx 36rpx; color: #fff; }
.hero-k { font-size: 23rpx; opacity: .78; }
.hero-t { display: flex; justify-content: space-between; align-items: flex-end; margin-top: 12rpx; }
.hero-l { min-width: 0; }
.hero-n { font-size: 40rpx; font-weight: 700; }
.hero-chg { display: inline-block; margin-top: 12rpx; font-weight: 700; font-size: 26rpx; border-radius: 16rpx; padding: 4rpx 16rpx; background: #fff; }
.hero-p { font-size: 68rpx; font-weight: 800; line-height: 1; white-space: nowrap; }
.hero-u { font-size: 26rpx; font-weight: 500; opacity: .8; margin-left: 6rpx; }
.dist { margin-top: 28rpx; display: flex; height: 12rpx; border-radius: 6rpx; overflow: hidden; gap: 4rpx; }
.dist-up { background: #FF8A8F; } .dist-flat { background: rgba(255,255,255,.35); } .dist-dn { background: #6FD39E; }
.dist-l { display: flex; justify-content: space-between; font-size: 22rpx; margin-top: 10rpx; opacity: .85; }
/* 榜单 */
.ch { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.ch-t { font-size: 30rpx; font-weight: 700; }
.ch-s { font-size: 21rpx; color: #8A978F; }
.tabs { display: flex; gap: 28rpx; }
.tab-i { font-size: 27rpx; color: #8A978F; padding-bottom: 6rpx; border-bottom: 4rpx solid transparent; }
.tab-i.on { color: #14211A; font-weight: 700; border-bottom-color: #14532D; }
.chips { white-space: nowrap; margin: 8rpx 0 4rpx; }
.chip { display: inline-block; font-size: 24rpx; padding: 8rpx 22rpx; margin-right: 12rpx; border-radius: 22rpx; background: #F0F3F0; color: #5E6E64; }
.chip.on { background: #14532D; color: #fff; font-weight: 600; }
.row { display: flex; align-items: center; gap: 14rpx; padding: 20rpx 0; border-top: 1rpx solid #F0F3F0; line-height: 1.3; }
.row.stale { opacity: .55; }
.nm { width: 196rpx; flex-shrink: 0; min-width: 0; }
.nm-t { font-size: 27rpx; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tag { font-size: 18rpx; font-weight: 500; color: #5E6E64; background: #EAF0EB; border-radius: 8rpx; padding: 2rpx 8rpx; margin-left: 8rpx; }
.nm-s { font-size: 21rpx; color: #9AA69F; margin-top: 2rpx; }
.rb { flex: 1; position: relative; height: 12rpx; background: #CFE3D6; border-radius: 6rpx; }
.rb-dot { position: absolute; top: -8rpx; width: 24rpx; height: 24rpx; margin-left: -12rpx; border-radius: 50%; background: #14532D; border: 4rpx solid #fff; box-shadow: 0 0 0 2rpx #14532D; box-sizing: border-box; }
.rb-space { flex: 1; }
.px { width: 140rpx; flex-shrink: 0; text-align: right; font-size: 30rpx; font-weight: 700; white-space: nowrap; }
.px-u { font-size: 19rpx; font-weight: 400; color: #8A978F; margin-left: 2rpx; }
.px-none { font-size: 22rpx; font-weight: 400; color: #9AA69F; }
.pill-space { min-width: 112rpx; }
.star { width: 40rpx; flex-shrink: 0; text-align: center; font-size: 32rpx; color: #C3CCC7; }
.star.on { color: #D9940A; }
