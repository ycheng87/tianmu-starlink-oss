.msg {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  border-top: 1rpx solid var(--border-light);
}

.tag {
  flex-shrink: 0;
  margin-right: 20rpx;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  line-height: 34rpx;
  white-space: nowrap;
}

.tag.price {
  background: var(--bg-tag-red);
  color: var(--color-red);
}

.tag.weather {
  background: var(--bg-tag-green);
  color: var(--color-green);
}

.tag.context {
  background: var(--bg-tag-blue);
  color: var(--color-blue);
}

.body {
  flex: 1;
  min-width: 0;
}

.t {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.d {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.meta {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
}

/* 空状态引导卡片 */
.empty-guide {
  text-align: center;
  padding: 80rpx 48rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  box-shadow: var(--shadow-card);
}

.empty-guide-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-guide-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.empty-guide-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
  line-height: 1.6;
  margin-bottom: 36rpx;
}

.empty-guide-btn {
  display: inline-block;
  background: var(--color-green);
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 56rpx;
  border-radius: 36rpx;
}

.msgs-disclaimer { margin: 32rpx 0 8rpx; text-align: center; font-size: 21rpx; color: #8A978F; line-height: 1.6; }
