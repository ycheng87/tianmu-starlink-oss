<view class="container {{themeClass}}">
  <!-- 骨架屏加载状态 -->
  <view class="skeleton" wx:if="{{loading}}">
    <view class="skeleton-card">
      <view class="skeleton-line medium"></view>
      <view class="skeleton-line short"></view>
      <view class="skeleton-line long"></view>
      <view class="skeleton-line long"></view>
      <view class="skeleton-line medium"></view>
    </view>
    <view class="skeleton-card">
      <view class="skeleton-line long"></view>
      <view class="skeleton-line long"></view>
      <view class="skeleton-line medium"></view>
    </view>
  </view>

  <view class="error-box" wx:if="{{error}}">
    <view class="err-text">{{error}}</view>
    <view class="btn-retry" bindtap="onRetry">重新加载</view>
  </view>

  <block wx:if="{{!loading && !error}}">
    <view class="card" wx:if="{{list.length}}">
      <view class="card-title">📢 波动预警 <text class="card-sub" wx:if="{{dateText}}">{{dateText}}</text></view>
      <view class="msg" wx:for="{{list}}" wx:key="key">
        <view class="tag {{item.tagClass}}">{{item.tagText}}</view>
        <view class="body">
          <view class="t">{{item.title}}</view>
          <view class="d">{{item.detail}}</view>
          <view class="meta" wx:if="{{item.category || item.date || item.time}}">
            <text wx:if="{{item.category}}">{{item.category}}</text>
            <text wx:if="{{item.category && item.date}}"> · </text>
            <text wx:if="{{item.date}}">{{item.date}}</text>
            <text wx:if="{{(item.category || item.date) && item.time}}"> · </text>
            <text wx:if="{{item.time}}">{{item.time}}</text>
          </view>
        </view>
      </view>
    </view>
    <!-- 空状态引导卡片 -->
    <view class="empty-guide" wx:else>
      <view class="empty-guide-icon">📢</view>
      <view class="empty-guide-title">暂无消息</view>
      <view class="empty-guide-desc">在此查看价格与天气的最新波动提示，也可以去行情页查看最新数据</view>
      <view class="empty-guide-btn" bindtap="onGoIndex">去行情页看看</view>
    </view>
  </block>
</view>
