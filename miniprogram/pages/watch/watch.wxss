.watch-page {
  padding-top: 24rpx;
  padding-bottom: 44rpx;
}

.watch-intro {
  padding: 0 4rpx 24rpx;
}

.watch-intro-title {
  color: var(--text-primary);
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.watch-intro-subtitle {
  margin-top: 10rpx;
  color: var(--text-tertiary);
  font-size: 25rpx;
}

.watch-info {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 24rpx;
  background: var(--bg-tag-green);
  border: 1rpx solid var(--border-card);
  border-radius: 26rpx;
  box-sizing: border-box;
}

.watch-info-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 68rpx;
  width: 68rpx;
  height: 68rpx;
  margin-right: 20rpx;
  color: var(--color-green);
  background: var(--bg-card);
  border-radius: 22rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.watch-info-copy { flex: 1; min-width: 0; }
.watch-info-title { color: var(--color-green); font-size: 28rpx; font-weight: 700; }
.watch-info-text { margin-top: 5rpx; color: var(--text-secondary); font-size: 23rpx; line-height: 1.45; }

.watch-empty-card,
.watch-steps-card,
.watch-list-card {
  background: var(--bg-card);
  border: 1rpx solid var(--border-card);
  border-radius: 28rpx;
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.watch-empty-card {
  text-align: center;
  padding: 54rpx 46rpx 42rpx;
  margin-bottom: 22rpx;
}

.watch-illustration {
  position: relative;
  width: 300rpx;
  height: 210rpx;
  margin: 0 auto 12rpx;
}

.watch-orbit {
  position: absolute;
  left: 113rpx;
  top: 4rpx;
  width: 68rpx;
  height: 68rpx;
  background: var(--bg-tag-green);
  border: 2rpx solid #BED8C7;
  border-radius: 50%;
}

.watch-star {
  position: absolute;
  left: 126rpx;
  top: 12rpx;
  color: #699A7D;
  font-size: 47rpx;
  line-height: 1;
}

.watch-dot {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  background: #CFE2D5;
  border-radius: 50%;
}

.dot-one { top: 25rpx; right: 34rpx; }
.dot-two { top: 78rpx; right: 50rpx; }

.watch-hill {
  position: absolute;
  left: 32rpx;
  width: 238rpx;
  height: 66rpx;
  border-top: 6rpx solid #9DBFA7;
  border-radius: 50% 50% 0 0;
  transform: rotate(2deg);
}

.hill-one { top: 117rpx; }
.hill-two { top: 145rpx; left: 24rpx; width: 258rpx; transform: rotate(-1deg); }
.hill-three { top: 174rpx; left: 16rpx; width: 274rpx; transform: rotate(1deg); }

.watch-field-mark {
  position: absolute;
  left: 75rpx;
  top: 91rpx;
  color: #4E8766;
  font-size: 72rpx;
  line-height: 1;
  font-weight: 700;
  transform: scaleX(1.15);
}

.watch-empty-title {
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.watch-empty-desc {
  color: var(--text-secondary);
  font-size: 25rpx;
  line-height: 1.65;
  margin: 0 auto 28rpx;
}

.watch-empty-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 250rpx;
  min-height: 74rpx;
  padding: 0 32rpx;
  color: #fff;
  background: var(--color-green);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(43, 102, 72, 0.16);
  font-size: 28rpx;
  font-weight: 700;
}

.watch-empty-button:active { opacity: 0.86; }
.watch-empty-footnote { margin-top: 18rpx; color: var(--text-tertiary); font-size: 22rpx; }

.watch-steps-card { padding: 24rpx 24rpx 20rpx; margin-bottom: 22rpx; }
.watch-steps-title { color: var(--text-secondary); font-size: 26rpx; font-weight: 700; margin-bottom: 20rpx; }
.watch-steps { display: flex; align-items: center; justify-content: space-between; }
.watch-step { width: 27%; text-align: center; }
.watch-step-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin: 0 auto 10rpx;
  color: var(--color-green);
  background: var(--bg-tag-green);
  border-radius: 20rpx;
  font-size: 25rpx;
  font-weight: 700;
}
.watch-step-label { color: var(--text-tertiary); font-size: 22rpx; white-space: nowrap; }
.watch-step-arrow { color: #9CAF9F; font-size: 32rpx; padding-bottom: 28rpx; }

.watch-empty-legend {
  display: flex;
  justify-content: space-around;
  align-items: center;
  min-height: 62rpx;
  color: var(--text-tertiary);
  background: var(--bg-tertiary);
  border-radius: 24rpx;
  font-size: 22rpx;
}
.watch-empty-legend text { color: var(--color-green); font-size: 26rpx; font-weight: 700; margin-right: 6rpx; }

.watch-list-card { margin-bottom: 14rpx; }
.watch-list-heading { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 26rpx 18rpx; }
.watch-list-title { color: var(--text-primary); font-size: 30rpx; font-weight: 700; }
.watch-list-caption { color: var(--text-tertiary); font-size: 22rpx; margin-top: 3rpx; }
.watch-manage { color: var(--color-green); background: var(--bg-tag-green); border-radius: 28rpx; padding: 8rpx 22rpx; font-size: 23rpx; }
.watch-manage.active { color: #fff; background: var(--color-green); }

.watch-filter-tabs { display: flex; padding: 4rpx 24rpx 18rpx; border-bottom: 1rpx solid var(--border-light); }
.watch-filter { margin-right: 12rpx; padding: 8rpx 22rpx; color: var(--text-secondary); background: var(--bg-tertiary); border-radius: 28rpx; font-size: 23rpx; }
.watch-filter.selected { color: #fff; background: var(--color-green); font-weight: 600; }

.watch-row { display: flex; align-items: center; padding: 22rpx 22rpx; border-bottom: 1rpx solid var(--border-light); }
.watch-row:last-of-type { border-bottom: 0; }
.watch-kind-mark { display: flex; align-items: center; justify-content: center; flex: 0 0 54rpx; width: 54rpx; height: 54rpx; margin-right: 16rpx; border-radius: 18rpx; font-size: 23rpx; font-weight: 700; }
.watch-kind-mark.flower { color: #9C6F3D; background: #F6EEE3; }
.watch-kind-mark.veg { color: var(--color-green); background: var(--bg-tag-green); }
.watch-row-main { flex: 1; min-width: 0; }
.watch-row-name { color: var(--text-primary); font-size: 28rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.watch-row-meta { margin-top: 5rpx; color: var(--text-tertiary); font-size: 20rpx; line-height: 1.35; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.watch-row-price-area { flex: 0 0 auto; min-width: 150rpx; margin-left: 10rpx; text-align: right; }
.watch-row-price { color: var(--text-primary); font-size: 29rpx; font-weight: 700; white-space: nowrap; }
.watch-row-price.no-quote { color: var(--text-tertiary); font-size: 25rpx; font-weight: 500; }
.watch-row-unit { color: var(--text-tertiary); font-size: 20rpx; font-weight: 400; }
.watch-row-change { display: flex; justify-content: flex-end; align-items: baseline; margin-top: 4rpx; font-size: 22rpx; font-weight: 600; }
.watch-row-change text { color: var(--text-tertiary); font-size: 19rpx; font-weight: 400; margin-left: 6rpx; }
.watch-row-change.up { color: var(--color-up); }
.watch-row-change.down { color: var(--color-down); }
.watch-row-change.flat { color: var(--color-flat); }
.watch-remove { flex: 0 0 auto; margin-left: 16rpx; padding: 7rpx 14rpx; color: var(--color-red); background: var(--color-red-light); border-radius: 24rpx; font-size: 21rpx; }
.watch-filter-empty { padding: 34rpx 24rpx; color: var(--text-tertiary); text-align: center; font-size: 24rpx; }
.watch-disclaimer { padding: 8rpx 4rpx; color: var(--text-tertiary); font-size: 21rpx; text-align: center; }

.skeleton-card { background: var(--bg-card); border-radius: 24rpx; padding: 28rpx; margin-bottom: 18rpx; }
.skeleton-line { height: 22rpx; margin: 18rpx 0; border-radius: 10rpx; background: var(--skeleton-base); }
.skeleton-line.medium { width: 38%; }
.skeleton-line.long { width: 82%; }

.error-box { text-align: center; padding: 70rpx 24rpx; color: var(--text-tertiary); }
.err-text { font-size: 25rpx; margin-bottom: 24rpx; }
.btn-retry { display: inline-block; padding: 12rpx 48rpx; color: #fff; background: var(--color-green); border-radius: 32rpx; font-size: 25rpx; }

.theme-dark .watch-orbit { border-color: #466552; }
.theme-dark .watch-hill { border-color: #597D64; }
.theme-dark .watch-star { color: #7AA989; }
